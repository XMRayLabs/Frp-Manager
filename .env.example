FRP_MANAGER_VERSION=latest

# Generate with: openssl rand -base64 48
APP_GLOBAL_SECRET=replace-with-a-long-random-secret

# Public host names used in generated client commands.
MASTER_API_HOST=manager.example.com
MASTER_API_PORT=9000
MASTER_API_SCHEME=https
MASTER_RPC_HOST=manager.example.com
MASTER_RPC_PORT=9001

# Keep true behind an HTTPS reverse proxy. Set false only for local HTTP testing.
APP_COOKIE_SECURE=true

# Only trust forwarding headers from these reverse proxy IPs or CIDRs.
APP_TRUSTED_PROXIES=127.0.0.1,::1

# Set true only while creating the first administrator, then immediately return it to false.
APP_ENABLE_REGISTER=false
APP_AUTO_UPDATE=true

# PostgreSQL deployment: docker-compose.yml + docker-compose.postgres.yml
# Generate with openssl rand -hex 32 (hex avoids DSN quoting issues).
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=1800

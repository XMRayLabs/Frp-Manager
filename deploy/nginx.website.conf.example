# Load this file inside nginx's http {} context, for example in /etc/nginx/conf.d/.
# Add these servers alongside the existing panel/RPC servers; do not replace them.
# Replace certificate paths with a certificate covering *.frp.xmray.de.
map $http_upgrade $frpp_website_connection {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name *.frp.xmray.de;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name *.frp.xmray.de;

    ssl_certificate /etc/letsencrypt/live/frp-web/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/frp-web/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        # The selected FRPS server's vhostHTTPPort, not panel API/RPC ports.
        proxy_pass http://127.0.0.1:9080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $frpp_website_connection;
        # Do not buffer AI chat / SSE streaming responses.
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
